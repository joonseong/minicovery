# Claude API 키. 비워 두면 가짜 응답(mock)으로 생성한다
ANTHROPIC_API_KEY=

# 운영 저장소. 비워 두면 로컬 파일(.data/db.json)을 쓴다 (Vercel에서는 반드시 채운다)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 야간 배치·알림 cron 호출 보호용
CRON_SECRET=dev-cron-secret

# /admin 접근용
ADMIN_TOKEN=dev-admin

# 인앱 결제 연동 전 베타: true면 Plus 안내에서 결제 없이 Plus를 켠다
PLUS_BETA_FREE=true

# Apple 로그인 토큰 검증용 (iOS 번들 ID)
APPLE_BUNDLE_ID=com.minicovery.app

# 카카오 로그인 토큰 확인용 (카카오 디벨로퍼스 > 앱 키의 앱 ID, 숫자)
KAKAO_APP_ID=
# Google 로그인 토큰 검증용 (GoogleService-Info.plist의 CLIENT_ID, 여러 개면 쉼표)
GOOGLE_CLIENT_IDS=

# 설정 화면에 보이는 버전
NEXT_PUBLIC_APP_VERSION=1.0.0

# 푸시 발송 (Firebase 서비스 계정 JSON 한 줄). 비우면 알림을 보내지 않는다
FIREBASE_SERVICE_ACCOUNT=
