# Claude API 키. 비워 두면 가짜 응답(mock)으로 생성한다
ANTHROPIC_API_KEY=

# 운영 저장소. 비워 두면 로컬 파일(.data/db.json)을 쓴다 (Vercel에서는 반드시 채운다)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 야간 배치·알림 cron 호출 보호용
CRON_SECRET=dev-cron-secret

# /admin 접근용
ADMIN_TOKEN=dev-admin

# 인앱 결제 연동 전 베타: true면 Plus 안내에서 결제 없이 Plus를 켠다
PLUS_BETA_FREE=true

# Apple 로그인 토큰 검증용 (iOS 번들 ID)
APPLE_BUNDLE_ID=com.minicovery.app

# 카카오 로그인 토큰 확인용 (카카오 디벨로퍼스 > 앱 키의 앱 ID, 숫자)
KAKAO_APP_ID=
# Google 로그인 토큰 검증용 (GoogleService-Info.plist의 CLIENT_ID, 여러 개면 쉼표)
GOOGLE_CLIENT_IDS=

# 설정 화면에 보이는 버전
NEXT_PUBLIC_APP_VERSION=1.0.0

# 푸시 발송 (Firebase 서비스 계정 JSON 한 줄). 비우면 알림을 보내지 않는다
FIREBASE_SERVICE_ACCOUNT=

# App Store Server API (구독 확인·알림). App Store Connect > 사용자 및 액세스 > 통합 > 인앱 구입 키 (.p8 내용, 줄바꿈은 \n도 됨)
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
# 샌드박스(TestFlight·심사) 거래 허용 여부. 비우면 허용. 출시 뒤 false로 바꾸면 TestFlight·샌드박스 구독이 운영 Plus를 켜지 못한다
IAP_ALLOW_SANDBOX=

# 하루(24시간) AI 비용 상한(달러). 넘으면 새 코스·Drop·쉬운 설명 생성을 잠시 막는다
DAILY_AI_BUDGET_USD=50

# 공개 주소 (공유 링크·비밀번호 재설정 메일의 링크에 쓴다)
NEXT_PUBLIC_APP_URL=https://minicovery.vercel.app

# Sign in with Apple 서버 키 (개발자 포털 > Keys > Sign in with Apple 키 .p8). 세 값이 모두 있으면
# 로그인 때 refresh token을 받아 두고, 계정 삭제 때 Apple 쪽 연결(revoke)도 끊는다. 키 본문은 줄바꿈을 \n으로 한 줄에
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# 비밀번호 재설정 메일. Resend에서 도메인 인증 후 발급. 비우면(개발) 메일 대신 콘솔에 링크를 찍는다
# MAIL_FROM 예: Minicovery <noreply@도메인>
RESEND_API_KEY=
MAIL_FROM=
